// ============================================================================
//  pg_dr_refresh.py configuration
//  JSON with // comments (the script strips comments before parsing).
//  Retention is NOT set here: each snapshot follows the retention policy
//  already configured on its protection group on the array.
// ============================================================================
{
  // ---------------------------------------------------------------- arrays --
  "source_array": {
    // Management FQDN, DNS alias, or management VIP/IP the script SSHes to.
    // The array's Purity name is read automatically with `purearray list`.
    "host": "flasharray1.testdrive.local",

    // Purity user for SSH logins; needs rights to snapshot, copy, and replicate.
    "ssh_user": "jjones",

    // Private key used for SSH. Set to null to use your ssh-agent or ~/.ssh defaults.
    "ssh_key": "~/.ssh/id_rsa_pure"
  },

  "target_array": {
    // Management FQDN, DNS alias, or management VIP/IP of the replication target.
    //  * --setup SSHes here to read the connection key (purearray list --connection-key
    //    --encrypted) and passes it to purearray connect --management-address <host>.
    //  * Every run finds the target in `purearray connection list --csv` on the source
    //    by the row that contains this host (its Management Address). The arrays count
    //    as connected only when the last field of that row (Status) is "connected";
    //    "connecting" is not enough.
    "host": "flasharray2.testdrive.local",

    // Optional. Purity array name of the target. If left out, it is read from the
    // connection list (or from `purearray list` on the target). Purity names can't
    // contain dots, so this is the short name, e.g. "flasharray2", never the FQDN.
    // "name": "flasharray2",

    // Purity user and private key for SSH logins to the target. If left out, the
    // source_array values are used. The user must be allowed to list the connection key.
    "ssh_user": "jjones",
    "ssh_key": "~/.ssh/id_rsa_pure",

    // true  = encrypted replication connection (purearray connect --encrypted), Purity//FA 6.6.7+.
    // false = unencrypted connection, for older Purity releases.
    "encrypted": true,

    // Replication network: "ip" (default) or "fc".
    "replication_transport": "ip",

    // --setup: seconds to wait for the connection status to change from "connecting" to
    // "connected" after purearray connect (or for an existing connection that isn't
    // "connected" yet). Minimum 10.
    "connect_timeout_seconds": 300
  },

  // ------------------------------------------------------------------ log --
  // Base log file path. A date code for the Monday of the current week is added
  // (e.g. pg_dr_refresh_20261102.log), so each week gets a new file.
  // A relative path is taken relative to the folder this config file is in.
  // If omitted, defaults to <script folder>/logs/pg_dr_refresh.log.
  // pure-dr-report.py -c <this file> reads its logs from the same place.
  "log_file": "/var/log/pure/pg_dr_refresh.log",

  // ------------------------------------------------------------- settings --
  "settings": {
    // Start of every snapshot suffix the script creates; the full suffix is
    // <prefix>-YYYYMMDD-HHMMSS, e.g. PG1.dr-20261103-101500. Letters, digits, dashes only.
    "snapshot_prefix": "dr",

    // true = wait for each replication to finish so the log records the data replicated
    //        and replication time (needed for pure-dr-report.py figures).
    // false = start replication and move on; runs are logged with status "started" and no
    //         data or time (the -V flag always waits).
    "wait_for_replication": true,

    // Seconds between replication progress checks while waiting (minimum 1).
    "poll_interval_seconds": 30,

    // Give up waiting for one replication after this many minutes and mark that pgroup failed (minimum 1).
    "replication_timeout_minutes": 720,

    // With -V, print one '#' for every N percent replicated (minimum 1). If the array does not
    // report a Progress column, the -V line shows "running" and the data transferred instead.
    "hash_every_percent": 3,

    // Maximum seconds any single CLI command may run before it is treated as failed (minimum 10).
    "ssh_timeout_seconds": 600
  },

  // ---------------------------------------------------- protection groups --
  // Processed in order. For each entry: snapshot source_pgroup, overwrite every
  // "target" volume from its "source" volume in that snapshot, then snapshot
  // dr_pgroup and replicate it to target_array.
  // --setup builds everything listed here on the source array: first every missing
  // volume (source and target), then source_pgroup and dr_pgroup, adding the volumes
  // to them, then target_array on dr_pgroup. Nothing that already exists is changed.
  "protection_groups": [
    {
      // Protection group on the source array to snapshot. --setup creates it if
      // missing and adds the "source" volumes below to it.
      "source_pgroup": "PG1",

      // Protection group containing the target volumes; snapshotted and replicated.
      // --setup creates it if missing and adds the "target" volumes and target_array to it.
      "dr_pgroup": "PG1-DR",

      // target = volume that gets overwritten (member of dr_pgroup).
      // source = volume in source_pgroup whose snapshot overwrites it.
      // size   = optional, used only by --setup: the size of a source volume it has to
      //          create (whole number + K, M, G, T or P, e.g. "100G", "2T"). The target
      //          volume is always made the same size as its source volume. If the source
      //          volume already exists, size is ignored and can be left out.
      "volumes": [
        { "target": "vol-data-01-dr", "source": "vol-data-01", "size": "100G" },
        { "target": "vol-data-02-dr", "source": "vol-data-02", "size": "100G" },
        { "target": "vol-log-01-dr",  "source": "vol-log-01",  "size": "100G" }
      ]
    },
    {
      "source_pgroup": "PG2",
      "dr_pgroup":     "PG2-DR",
      "volumes": [
        { "target": "sql-db-dr",  "source": "sql-db",  "size": "100G" },
        { "target": "sql-log-dr", "source": "sql-log", "size": "100G" }
      ]
    }
  ]
}
